{
  "name": "jarvis-local",
  "version": "0.2.0",
  "private": true,
  "description": "JARVIS local wake-word desktop prototype",
  "author": "JARVIS local project",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "prepare:response": "node scripts/prepare-response.cjs",
    "build:ui": "npm run prepare:response && vite build",
    "test": "node --test tests/*.test.cjs",
    "build:worker": ".venv\\Scripts\\python.exe -m PyInstaller --noconfirm worker.spec",
    "package": "npm run build:ui && npm run build:worker && electron-builder --dir",
    "smoke": "npm run build:ui && electron . --smoke-test"
  },
  "build": {
    "appId": "local.jarvis.desktop",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "ui-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/jarvis-worker",
        "to": "worker"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
